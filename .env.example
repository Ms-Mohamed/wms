# Copy to .env and fill in. NEVER commit .env.
POSTGRES_PASSWORD=change-me
# Password of the read-only database role used by the analytics service
WMS_RO_PASSWORD=change-me-too
# >= 32 characters. Shared by the C# API (signs tokens) and the analytics service (verifies them).
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# First admin account (username: admin). Only used when the users table is empty. Min 8 chars.
WMS_ADMIN_PASSWORD=change-me-admin
# true = load the demo catalogue on first start
SEED_DEMO_DATA=true
