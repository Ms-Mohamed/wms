# Local development only (Docker passes these through docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wms_db
DB_USER=wms_ro          # read-only role (see db/init/01-readonly-role.sh)
DB_PASSWORD=change-me
# Must equal the C# API's JwtSettings__SecretKey
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# Optional tuning
DB_POOL_MAX=8
CACHE_TTL_SECONDS=10
LEAD_TIME_DAYS=7
ORDERING_COST=50.0
HOLDING_COST_RATE=0.20
SAFETY_STOCK_MULTIPLIER=1.5
