# Configuration PostgreSQL pour le Backend Python
# Copiez ce fichier en .env et remplissez avec vos valeurs réelles

DB_HOST=localhost
DB_PORT=5432
DB_NAME=wms_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Paramètres optionnels pour les calculs d'optimisation
LEAD_TIME_DAYS=7
ORDERING_COST=50.0
HOLDING_COST_RATE=0.20
SAFETY_STOCK_MULTIPLIER=1.5
