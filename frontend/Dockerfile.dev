FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

# We don't copy specific files here because we bind mount the volume in docker-compose
# COPY . . 

EXPOSE 80

# Run with --host to expose to network, --port 80 to match existing port mapping
CMD ["npm", "run", "dev", "--", "--host", "--port", "80"]
